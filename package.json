{
  "name": "mudraforge-decompiler",
  "version": "1.0.0",
  "description": "Zero-shot neuro-symbolic compiler for computational law and statutory reasoning",
  "type": "module",
  "main": "compiler/vm/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MudraForge/mudraforge-decompiler.git"
  },
  "homepage": "https://github.com/MudraForge/mudraforge-decompiler#readme",
  "bugs": {
    "url": "https://github.com/MudraForge/mudraforge-decompiler/issues"
  },
  "scripts": {
    "test": "npm run audit && npm run test:unit && npm run test:training && npm run test:deonticbench",
    "test:unit": "python -m unittest discover tests -v",
    "test:catala": "python -m unittest tests/test_catala_emitter.py",
    "fetch:catala": "node scripts/fetch_catala_interpreter.mjs",
    "check:catala": "node scripts/fetch_catala_interpreter.mjs --check",
    "emit:catala": "python scripts/emit_catala_fixtures.py",
    "check:catala:fixtures": "python scripts/emit_catala_fixtures.py --check",
    "test:catala:verified": "node scripts/fetch_catala_interpreter.mjs && python -m unittest tests/test_french_tax_catala_verified.py tests/test_french_tax_cross_engine.py",
    "test:training": "python train.py --smoke-test",
    "test:sara": "python benchmarks/test_sara_benchmark.py",
    "test:deonticbench": "python benchmarks/test_crossdomain_deonticbench.py",
    "test:all": "npm run test && npm run test:sara",
    "audit": "python scripts/security_audit.py"
  },
  "author": "MudraForge Labs <engineering@mudraforge.in>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@mudraforge/statutory": "^3.1.0"
  }
}
